# ==============================================================================
# Django Core Settings
# ==============================================================================
# 1 - включено (для локальной разработки), 0 - выключено (для продакшена)
DEBUG=0
# Сгенерируйте надежный ключ для продакшена
SECRET_KEY=django-insecure-change-me-in-production
# Список хостов через запятую
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Список доверенных источников для CSRF (нужно для работы админки через Nginx)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000


# ==============================================================================
# PostgreSQL Settings
# ==============================================================================
POSTGRES_DB=vstuschedule
POSTGRES_USER=vstusched
POSTGRES_PASSWORD=db_password
DB_HOST=db
DB_PORT=5432


# ==============================================================================
# Redis & Celery Settings
# ==============================================================================
# 'redis' - имя сервиса из docker-compose.yml
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ==============================================================================
# Host Nginx deployment (docker-compose.host.yml)
# ==============================================================================
# Порт Gunicorn на хосте, к которому проксирует системный Nginx.
WEB_PORT=8000
# Каталоги должны совпадать с alias для /static/ и /media/ в системном Nginx.
STATIC_HOST_PATH=./.deploy/data/static
MEDIA_HOST_PATH=./.deploy/data/media


# ==============================================================================
# Import entity corrections (L1 rewrite, L2 match, L3 disambiguation)
# ==============================================================================
# 1 — строки teacher/group/subject/place прогонять через курируемые слои.
# 0 — старый импорт: точное имя после normalize_* и создание, если нет в БД.
IMPORT_USE_CORRECTIONS=0
# Имеет смысл только при IMPORT_USE_CORRECTIONS=1.
# 0 — нет однозначной привязки: открыть L3-кейс и всё равно создать/найти сущность
#     по точному имени (как раньше). Параллельный режим, импорт не падает.
# 1 — нет однозначной привязки: сущность не создавать, занятие пропустить,
#     оставить кейс в очереди L3. Нужен, чтобы не плодить дубли преподавателей
#     и аудиторий после наполнения словаря.
IMPORT_CORRECTIONS_STRICT=0
